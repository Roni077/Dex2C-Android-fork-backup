{
  "name": "Darcula",
  "type": "dark",
  "colors": {
    "editor.background": "#2B2B2B",
    "editor.foreground": "#A9B7C6",
    "editor.lineHighlightBackground": "#323232",
    "editor.selectionBackground": "#214283",
    "editorLineNumber.foreground": "#606366",
    "editorLineNumber.activeForeground": "#A4A3A3"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.line"],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#6897BB"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.other.directive"],
      "settings": {
        "foreground": "#CC7832",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["storage.modifier", "storage.type"],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "scope": ["variable.parameter.register", "variable"],
      "settings": {
        "foreground": "#9876AA"
      }
    },
    {
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#FFC66D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.function", "entity.name.function.method"],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "scope": ["storage.type.class", "storage.type.array"],
      "settings": {
        "foreground": "#A9B7C6"
      }
    }
  ]
}
